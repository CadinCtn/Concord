{
  "name": "vcall",
  "version": "1.0.0",
  "description": "Video-chamada multi-party com WebRTC + mediasoup + Socket.IO",
  "main": "server/index.js",
  "scripts": {
    "start": "node server/index.js",
    "dev": "nodemon server/index.js",
    "build:client": "esbuild public/js/mediasoupClientEntry.js --bundle --outfile=public/js/mediasoup-bundle.js --format=iife"
  },
  "dependencies": {
